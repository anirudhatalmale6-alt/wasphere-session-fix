diff --git a/packages/dashboard-ui/lib/cookie-security.ts b/packages/dashboard-ui/lib/cookie-security.ts
new file mode 100644
index 0000000..968abf0
--- /dev/null
+++ b/packages/dashboard-ui/lib/cookie-security.ts
@@ -0,0 +1,32 @@
+/**
+ * Should the auth cookies (wa_access / wa_refresh) carry the `Secure` attribute?
+ *
+ * A browser only stores a `Secure` cookie when the page origin is a secure
+ * context. `https://…` qualifies, and so does `localhost` — which is why the
+ * stock instructions ("open http://localhost:3004") work. A public origin
+ * served over plain http, e.g. http://203.0.113.10:3004, does NOT: the cookie
+ * is discarded silently, with no error in the browser and nothing in the server
+ * logs. Login then succeeds, the redirect to /dashboard runs, the server-side
+ * guard finds no wa_access cookie and bounces to /login?reason=expired —
+ * "Your session has expired. Please log in again."
+ *
+ * COOKIE_SECURE makes that an explicit deployment choice instead of a side
+ * effect of NODE_ENV:
+ *
+ *   COOKIE_SECURE=true    behind HTTPS (the right answer for production)
+ *   COOKIE_SECURE=false   plain http on an IP or a TLS-less host
+ *   unset                 previous behaviour: secure when NODE_ENV=production
+ *
+ * Read at call time, never at module load: a build-time read would bake the
+ * value into the image and ignore whatever the container is actually given.
+ */
+export function cookieSecure(): boolean {
+  const explicit = process.env.COOKIE_SECURE;
+
+  if (explicit !== undefined && explicit.trim() !== "") {
+    const v = explicit.trim().toLowerCase();
+    return v === "true" || v === "1" || v === "yes";
+  }
+
+  return process.env.NODE_ENV === "production";
+}
