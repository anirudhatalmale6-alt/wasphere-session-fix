diff --git a/.env.example b/.env.example
index c72ccc9..c461255 100644
--- a/.env.example
+++ b/.env.example
@@ -36,6 +36,29 @@ INTERNAL_WEBHOOK_SECRET=change_me_openssl_rand_hex_32
 # Change to https://app.your-domain.com when behind a reverse proxy.
 DASHBOARD_UI_URL=http://localhost:3004
 
+# ── Login cookies ─────────────────────────────────────────────────────────────
+# The dashboard stores its session in the cookies wa_access / wa_refresh. They
+# are sent with the `Secure` attribute, and a browser only STORES a Secure
+# cookie on a secure origin: https://…, or localhost (which is why the default
+# setup above works).
+#
+# Serve the dashboard over plain http on anything else — http://<your-ip>:3004,
+# or a domain with no certificate — and the browser throws both cookies away
+# without a word. Nothing appears in the browser console or the container logs.
+# The login call itself returns 200, the redirect to /dashboard runs, the
+# server-side guard finds no cookie, and you land back on the login page with
+# "Your session has expired. Please log in again." Recreating the user or
+# changing the password makes no difference — the credentials were never the
+# problem.
+#
+#   COOKIE_SECURE=true    behind HTTPS — correct for production, and the default
+#   COOKIE_SECURE=false   plain http on an IP / a host with no TLS
+#
+# false is a real trade-off: the session cookie then travels in clear text and
+# anyone on the network path can read it and impersonate the user. Treat it as a
+# temporary state and put TLS in front as soon as you can, then set it back.
+# COOKIE_SECURE=true
+
 # Host ports (override only if 3000/3001/3004 clash with something else)
 # DASHBOARD_UI_PORT=3004
 # DASHBOARD_API_PORT=3000
